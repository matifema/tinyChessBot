generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

enum ListingStatus {
  for_sale
  for_rent
  sold
  rented
}

enum PropertyType {
  appartamento
  villa
  casale
  negozio
  terreno
  box
}

model Listing {
  id              String        @id @default(uuid())
  referenceNumber Int           @unique @default(autoincrement()) @map("reference_number")
  title           String
  description     String?
  location        String
  price           Decimal
  status          ListingStatus @default(for_sale)
  propertyType    PropertyType  @map("property_type")
  bedrooms        Int?
  bathrooms       Int?
  squareMeters    Int?          @map("square_meters")
  imageUrls       String[]      @map("image_urls")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
}
