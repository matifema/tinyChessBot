generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("D1_DATABASE_URL")
}

enum ListingStatus {
  for_sale
  for_rent
  sold
  rented
}

enum PropertyType {
  appartamento
  villa
  casale
  negozio
  terreno
  box
}

model Listing {
  id              String        @id
  referenceNumber Int           @unique @map("reference_number")
  title           String
  description     String?
  location        String
  price           Float
  status          ListingStatus @default(for_sale)
  propertyType    PropertyType  @map("property_type")
  bedrooms        Int?
  bathrooms       Int?
  squareMeters    Int?          @map("square_meters")
  imageUrls       String        @map("image_urls") // JSON string in D1
  createdAt       DateTime      @map("created_at")
  updatedAt       DateTime      @map("updated_at")
}
